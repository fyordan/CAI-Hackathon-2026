 },
 "cues": [
  {
   "t": 0,
   "speaker": "office",
   "text": "Foot and Ankle Hato Rey, buenos días, le habla Wanda.",
   "event": null
  },
  {
   "t": 3.44,
   "speaker": "agent",
   "text": "Buenos días, Wanda. Le habla CitaYa, un asistente automatizado, llamando de parte de la paciente Marisol Rivera. Quisiera una cita de podiatría por una uña encarnada.",
   "event": null
  },
  {
   "t": 13.68,
   "speaker": "office",
   "text": "Ajá. ¿Es paciente nueva?",
   "event": null
  },
  {
   "t": 16.8,
   "speaker": "agent",
   "text": "Sí, es paciente nueva. Ella solo puede los jueves, y necesita la cita antes del diecinueve de noviembre.",
   "event": null
  },
  {
   "t": 22.56,
   "speaker": "office",
   "text": "Déjeme ver… El jueves cinco lo tengo lleno. Tengo el jueves diecinueve de noviembre, a las diez de la mañana.",
   "event": null
  },
  {
   "t": 30.96,
   "speaker": "system",
   "text": null,
   "event": "SLOT_OFFERED"
  },
  {
   "t": 30.96,
   "speaker": "agent",
   "text": "Perfecto, el jueves diecinueve a las diez. ¿Aceptan el plan Triple-S?",
   "event": null
  },
  {
   "t": 35.36,
   "speaker": "office",
   "text": "Sí, Triple-S lo aceptamos. ¿Y el nombre completo de la paciente?",
   "event": null
  },
  {
   "t": 40.32,
   "speaker": "agent",
   "text": "Marisol Rivera. Ella lleva la tarjeta del plan el día de la cita.",
   "event": null
  },
  {
   "t": 44.88,
   "speaker": "office",
   "text": "Listo. Queda separada: jueves diecinueve, diez de la mañana, con el doctor Ramos. Que llegue quince minutos antes con su tarjeta del plan.",
   "event": null
  },
  {
   "t": 54.32,
   "speaker": "system",
   "text": null,
   "event": "BOOKED"
  },
  {
   "t": 54.32,
   "speaker": "agent",
   "text": "Excelente. Si se abre algo más temprano un jueves, ¿la pueden poner en la lista de cancelaciones?",
   "event": null
  },
  {
   "t": 58.88,
   "speaker": "office",
   "text": "Sí, claro, la apunto.",
   "event": null
  },
  {
   "t": 61.84,
   "speaker": "agent",
   "text": "Muchas gracias, Wanda. Que tenga buen día.",
   "event": null
  },
  {
   "t": 64.32,
   "speaker": "system",
   "text": null,
   "event": "COMPLETED"
  }
 ],
