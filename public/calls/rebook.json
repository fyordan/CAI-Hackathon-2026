  {
   "t": 19.36,
   "speaker": "system",
   "text": null,
   "event": "SLOT_OFFERED"
  },
  {
   "t": 19.71,
   "speaker": "agent",
   "text": "Perfecto, la tomamos. Por favor muévala al veintinueve a las dos y media, y liberen la del diecinueve.",
   "event": null
  },
  {
   "t": 25.67,
   "speaker": "office",
   "text": "Hecho. Jueves veintinueve de octubre, dos y media de la tarde.",
   "event": null
  },
