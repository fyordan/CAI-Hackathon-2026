DATABASE_URL=postgres://postgres@127.0.0.1:5433/citaya

# --- LLM (OpenRouter) ---------------------------------------------------------
OPENROUTER_API_KEY=
# Low-latency tier: per-turn understanding, intent, safety classifier (~0.8-1.5 s)
FAST_MODEL=google/gemini-3.5-flash-lite
FAST_MODEL_FALLBACK=anthropic/claude-haiku-5.5
# Reasoning tier: writes the phone-call dialogue (~2.4 s; sonnet-5.5 is richer but ~8 s of extra ringing)
REASONER_MODEL=google/gemini-3.5-flash-lite
REASONER_MODEL_FALLBACK=anthropic/claude-sonnet-5.5
# LLM_TIMEOUT_MS=6000          # turn falls back to the offline rule brain after this
# DIALOGUE_TIMEOUT_MS=12000     # call falls back to template lines after this

# --- Voice (ElevenLabs) -------------------------------------------------------
ELEVENLABS_API_KEY=
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5     # spoken chat replies (lowest latency)
# ELEVENLABS_DIALOGUE_MODEL=eleven_v3        # two-voice office calls
# Free plan = premade voices only. On a paid plan use Puerto Rican library voices, e.g.
#   Leo (ISTw2UT8hNs80bzKPenA), Veronica (cryPG4aBcWsmW2cCIXjB), Ivan (zwDSHuqO0tEVwNUuHmR1)
# ELEVENLABS_VOICE_AGENT=iP95p4xoKVk53GoZ742B
# ELEVENLABS_VOICE_OFFICE_F=cgSgspJ2msm6clMCkdW9
# ELEVENLABS_VOICE_OFFICE_M=cjVigY5qzO86Huf0OWal
# CALL_AUDIO=featured   # featured (booking/rebook/cancel calls) | all | off
# TTS_MAX_CHARS=400

# Optional: real Google Calendar invites (untested)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary
# Demo pacing between streamed chips when the rule brain answers (ms)
# DEMO_PACE_MS=380
